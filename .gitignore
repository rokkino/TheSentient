.env
# 1. Ambiente Virtuale
# Contiene migliaia di file di librerie, non deve mai essere caricato.
.venv/

# 2. File del Modello AI
# Troppo grandi per GitHub (limite di 100MB).
# Chiunque cloni il repository deve scaricarli manualmente.
model/

# 3. Cache di Python
# File temporanei generati da Python durante l'esecuzione.
__pycache__/


# 4. Impostazioni Locali di VS Code
# Impostazioni specifiche del tuo computer (come quale interprete usare).
.vscode/

# 5. File di Impostazioni
# Spesso contiene percorsi locali o API key (se le aggiungerai).
# È meglio non caricarlo, ma caricare un file 'settings.example.json'
settings.json

# 6. Cache Earnings Service
# Cache persistente per earnings (salvato per 12h)
backend/cache/
cache/
*.cache.json

# 7. Runtime Database (dati persistenti, mai da sovrascrivere con un deploy)
**/thesentient.db
**/sentient.db
**/app.db

# 8. File JSON dinamici generati a runtime (il server li rigenera da solo)
**/earnings_data.json
**/earnings_*.json
**/profitto.json
**/watchlist.json
**/dump.txt

# 9. Memory (tutta la cartella: chat, bot decisions, earnings cache, graph, news)
**/memory/

# 10. Log files
*.log
data/logs/

# 11. Virtual environments
venv/

# 12. Node modules
node_modules/

# 13. Frontend build output
dist/