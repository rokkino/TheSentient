/* Global Styles */
QWidget {
    background-color: #1e1e1e;
    color: #dcdcdc;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
}

QMainWindow {
    border: 1px solid #333333;
}

/* Inputs */
QLineEdit, QSpinBox {
    background-color: #2d2d2d;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 8px;
    color: #dcdcdc;
}

QLineEdit:focus, QSpinBox:focus {
    border: 1px solid #007acc;
}

/* Lists */
QListWidget {
    background-color: #2d2d2d;
    border: 1px solid #444444;
    border-radius: 6px;
}

QListWidget::item {
    padding: 10px 8px;
}

QListWidget::item:hover {
    background-color: #3a3a3a;
}

QListWidget::item:selected {
    background-color: #007acc;
    color: #ffffff;
}

/* Buttons */
QPushButton {
    background-color: #3c3c3c;
    color: #dcdcdc;
    border: 1px solid #555555;
    padding: 6px 12px;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #4a4a4a;
    border-color: #666666;
}

QPushButton:pressed {
    background-color: #2a2a2a;
}

QPushButton#RemoveButton {
    background-color: #5a2a27;
    border-color: #6a3a37;
}

QPushButton#RemoveButton:hover {
    background-color: #7a3a37;
}

/* Labels */
QLabel#TitleLabel {
    font-size: 24px;
    font-weight: bold;
    color: #f0f0f0;
    padding-top: 10px;
    padding-bottom: 10px;
}

QLabel#InfoLabel {
    font-size: 16px;
    color: #888888;
}

QLabel#PanelTitle {
    font-size: 16px;
    font-weight: bold;
    padding: 8px 0px;
    border-bottom: 1px solid #444444;
    color: #e0e0e0;
}

/* Splitter */
QSplitter::handle {
    background-color: #333333;
}

QSplitter::handle:hover {
    background-color: #007acc;
}

/* Timeframe & Chart Type Buttons */
QPushButton#TimeframeButton, QPushButton#ChartTypeButton {
    padding: 4px 8px;
    font-size: 12px;
    border-radius: 4px;
    border: 1px solid #333;
    background-color: #2d2d2d;
}

QPushButton#TimeframeButton:hover, QPushButton#ChartTypeButton:hover {
    background-color: #3d3d3d;
}

QPushButton#TimeframeButton:checked, QPushButton#ChartTypeButton:checked {
    background-color: #007acc;
    color: #ffffff;
    border-color: #007acc;
}

/* Icon Buttons */
QPushButton#IconButton {
    padding: 4px;
    border-radius: 4px;
    border: 1px solid #333;
    background-color: transparent;
}

QPushButton#IconButton:hover {
    background-color: #3d3d3d;
}

QPushButton#IconButton:checked {
    background-color: #007acc;
    border-color: #007acc;
}

/* --- News Card Styles (Improved) --- */
#NewsCard {
    background-color: #252526;
    border: 1px solid #333333;
    border-radius: 8px;
    margin-bottom: 8px;
    min-height: 140px;
}

#NewsCard:hover {
    border-color: #007acc;
    background-color: #2a2a2b;
}

#AccentBar {
    background-color: #007acc;
    border-radius: 2px;
    min-width: 4px;
    max-width: 4px;
}

#NewsTitle {
    font-size: 16px; /* Increased from 15px */
    font-weight: bold;
    color: #ffffff;
    padding-bottom: 6px;
}

#NewsSummary {
    font-size: 14px; /* Increased from 13px */
    color: #e0e0e0; /* Lighter color for better contrast */
    line-height: 1.5;
}

#MetaChip {
    background-color: #3a3a3a; /* Slightly lighter background */
    border-radius: 4px;
    color: #cccccc; /* Lighter text */
    font-size: 11px;
    padding: 2px 6px;
    margin-right: 4px;
    border: 1px solid #444444;
}

#MetaTime {
    color: #999999; /* Lighter text */
    font-size: 11px;
}

#SummaryDivider {
    background-color: #444444; /* More visible divider */
    height: 1px;
    margin: 8px 0px;
}

#ReadButton {
    background-color: transparent;
    color: #3399ff; /* Brighter blue */
    border: none;
    font-size: 13px;
    font-weight: bold;
    text-align: left;
    padding: 4px 0px;
}

#ReadButton:hover {
    color: #66b2ff;
    text-decoration: underline;
}

/* Trading Signal in Card */
#TradingSignal {
    background-color: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 10px;
    margin-top: 10px;
}

#TradingSignal.bearish {
    border-color: #8b0000;
    background-color: #2a1a1a;
}

#SignalLabel {
    font-size: 12px;
    font-weight: bold;
    color: #dcdcdc;
}

#SignalLabel.bearish {
    color: #ff6b6b;
}

#SignalInfo {
    font-size: 11px;
    color: #aaaaaa;
}

#LoadingText {
    font-size: 11px;
    color: #888888;
}

/* Sidebar ScrollArea */
QScrollArea {
    border: none;
    background-color: #1e1e1e;
}

#ScrollAreaWidget {
    background-color: #1e1e1e;
}

/* Settings Dialog */
#DialogHeader {
    background-color: #252526;
    border-bottom: 1px solid #333333;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

#DialogTitle {
    font-weight: bold;
    font-size: 14px;
}

#HeaderButton {
    background-color: transparent;
    border: none;
    color: #aaaaaa;
    font-weight: bold;
}

#HeaderButton:hover {
    color: #ffffff;
    background-color: #333333;
    border-radius: 4px;
}

#SectionTitle {
    color: #007acc;
    font-size: 12px;
    font-weight: bold;
    text-transform: uppercase;
    margin-top: 12px;
    margin-bottom: 4px;
    border-bottom: 1px solid #333333;
}

QPushButton#SettingToggle {
    background-color: #333333;
    border: 1px solid #444444;
    border-radius: 10px;
    padding: 2px 10px;
    color: #aaaaaa;
    font-size: 11px;
    font-weight: bold;
}

QPushButton#SettingToggle:checked {
    background-color: #007acc;
    border-color: #007acc;
    color: #ffffff;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #1e1e1e;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #444444;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
